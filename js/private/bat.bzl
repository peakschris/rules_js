"""Windows Batch snippets for js rules"""

# Batch snippet to initialize the RUNFILES environment variable on Windows.
# This is the Windows batch equivalent of BASH_INITIALIZE_RUNFILES in bash.bzl and
# is kept in lockstep with it. Depends on there being a :logf_fatal label and a
# :cleanup_and_exit label defined, and on delayed expansion being enabled
# (setlocal enabledelayedexpansion).
#
# NB: Unlike an earlier Windows port this does NOT set NODE_PATH; module resolution
# is handled by the launcher preload (node-bootstrap/launcher.cjs) at runtime, which
# is also what the bash launcher relies on.
BAT_INITIALIZE_RUNFILES = r"""
rem Set a RUNFILES environment variable to the root of the runfiles tree
rem since RUNFILES_DIR is not set by Bazel in all contexts.
rem For example, `RUNFILES=C:\path\to\my_js_binary.bat.runfiles`.
rem
rem Call this program X. X was generated by a genrule and may be invoked
rem in many ways:
rem   1a) directly by a user, with %0 in the output tree
rem   1b) via 'bazel run' (similar to case 1a)
rem   2) directly by a user, with %0 in X's runfiles
rem   3) by another program Y which has a data dependency on X, with %0 in Y's runfiles
rem   4a) via 'bazel test'
rem   4b) case 3 in the context of a test
rem   5a) by a genrule cmd, with %0 in the output tree
rem   6a) case 3 in the context of a genrule
rem
rem For case 1, %0 will be a regular file, and the runfiles will be at %0.runfiles.
rem For case 4, %TEST_SRCDIR% should already be set to the runfiles by bazel.
rem Case 5a is handled like case 1. Case 6a is handled like case 3.

if defined TEST_SRCDIR (
    rem Case 4, bazel has identified runfiles for us.
    set "RUNFILES=%TEST_SRCDIR%"
    set "RUNFILES=!RUNFILES:/=\!"
) else if defined RUNFILES_MANIFEST_FILE (
    set "RUNFILES=%RUNFILES_MANIFEST_FILE%"
    set "RUNFILES=!RUNFILES:/=\!"
    rem Bazel puts the manifest beside the runfiles with the suffix .runfiles_manifest.
    if "!RUNFILES:~-17!"==".runfiles_manifest" (
        set "RUNFILES=!RUNFILES:~0,-17!"
    ) else (
        rem Bazel for Windows may instead put a MANIFEST file inside the runfiles dir.
        echo !RUNFILES! | %SYSTEMROOT%\system32\findstr.exe /c:"\MANIFEST" >nul
        if !errorlevel! equ 0 (
            set "RUNFILES=!RUNFILES:\MANIFEST=!"
        ) else (
            call :logf_fatal "Unexpected RUNFILES_MANIFEST_FILE value %RUNFILES_MANIFEST_FILE%"
            set "_exit_code=1"
            goto :cleanup_and_exit
        )
    )
) else (
    rem Case 1/2/3: look for a .runfiles directory beside this script, or detect
    rem that this script is itself inside a .runfiles tree.
    set "self=%~f0"
    if exist "!self!.runfiles" (
        set "RUNFILES=!self!.runfiles"
    ) else (
        echo !self! | %SYSTEMROOT%\system32\findstr.exe /c:".runfiles\" >nul
        if !errorlevel! equ 0 (
            rem Trim everything after (and including) the first ".runfiles\" segment,
            rem then re-append ".runfiles" to get the runfiles root. The '*' sentinel
            rem cannot appear in a valid Windows path.
            set "_marked=!self:.runfiles\=.runfiles*!"
            for /f "tokens=1 delims=*" %%a in ("!_marked!") do set "RUNFILES=%%a"
        )
    )
    if not defined RUNFILES (
        call :logf_fatal "RUNFILES environment variable is not set"
        set "_exit_code=1"
        goto :cleanup_and_exit
    )
    set "RUNFILES=!RUNFILES:/=\!"
)

rem Ensure RUNFILES is an absolute path. It may be relative to the PWD in the case
rem where RUNFILES_MANIFEST_FILE was used above.
echo !RUNFILES! | %SYSTEMROOT%\system32\findstr.exe "^[A-Za-z]:" >nul
if !errorlevel! neq 0 (
    set "RUNFILES=%CD%\!RUNFILES!"
)

rem Set RUNFILES_DIR if not already set so that tools such as @bazel/runfiles can
rem locate runfiles without requiring RUNFILES to be exported.
if not defined RUNFILES_DIR set "RUNFILES_DIR=!RUNFILES!"
"""
